<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="sling:Page"
    sling:resourceType="component-library/components/page">
    <jcr:content
        jcr:primaryType="nt:unstructured"
        jcr:title="Home"
        sling:resourceType="component-library/components/page">

        <header
            jcr:primaryType="nt:unstructured"
            sling:resourceType="component-library/components/header"
            siteName="Aakash Portfolio"
            homePagePath="/content/aakash-portfolio/home.html">
            <navItems jcr:primaryType="nt:unstructured">
                <item1
                    jcr:primaryType="nt:unstructured"
                    label="About"
                    path="/content/aakash-portfolio/home.html#about"/>
                <item2
                    jcr:primaryType="nt:unstructured"
                    label="Projects"
                    path="/content/aakash-portfolio/home.html#projects"/>
                <item3
                    jcr:primaryType="nt:unstructured"
                    label="Contact"
                    path="/content/aakash-portfolio/home.html#contact"/>
            </navItems>
        </header>

        <hero-banner
            jcr:primaryType="nt:unstructured"
            sling:resourceType="component-library/components/hero-banner"
            jobTitle="Associate Software Developer"
            name="Hello, my name &lt;br&gt; is Aakash Baskaran"
            description="Nearly two years of industry experience: AEM 6.x at Accenture for Chubb Insurance, then Android development at Zoho. Preparing for the Adobe AD0-E123 certification (in progress)."
            button1Text="Projects"
            button2Text="LinkedIn"
            button1Path="/content/aakash-portfolio/home.html#projects"
            button2Path="https://www.linkedin.com/in/aakashbaskaran/"
            imagePath="/content/aakash-portfolio/assets/images/Illustration.png"/>

        <about-title
            jcr:primaryType="nt:unstructured"
            sling:resourceType="component-library/components/section-title"
            title="About Me"/>

        <about-banner
            jcr:primaryType="nt:unstructured"
            sling:resourceType="component-library/components/hero-banner"
            description="From January to October 2021 I was an Associate Software Developer on the AEM Platform team at Accenture. The client was Chubb Insurance and the work was on AEM 6.x. I published and maintained 100+ pages, standardised reusable AEM component templates that reduced authoring time by about 30%, administered DAM workflows, and carried out cross-browser and WCAG 2.0 quality checks.&lt;br&gt;&lt;br&gt;From November 2021 to December 2022 I was an Android Developer at Zoho. That is nearly two years of industry experience in total. I am preparing for the Adobe AD0-E123 certification (in progress). This website is a personal learning project for HTL components and Sling Models."
            styleClass="about-section"
            button1Text="Resume"
            button1Path="/content/aakash-portfolio/assets/documents/Aakash_Baskaran_Resume.pdf"
            button1Download="Aakash_Baskaran_Resume.pdf"
            imagePath="/content/aakash-portfolio/assets/images/about_img.png"/>

        <projects-title
            jcr:primaryType="nt:unstructured"
            sling:resourceType="component-library/components/section-title"
            title="Projects"/>

        <project1
            jcr:primaryType="nt:unstructured"
            sling:resourceType="component-library/components/project-card"
            title="AEM Component Library"
            description="Personal learning project used while preparing for the Adobe AD0-E123 certification. Seven HTL components, Sling Models on the header, hero banner, project card, and footer, a client library, and a Maven build with core, ui.apps, and ui.content modules.&lt;br&gt;&lt;br&gt;Technologies in this repository: Java, HTL, Sling Models, Maven, CSS, and JavaScript.&lt;br&gt;"
            buttonText="View Project"
            buttonPath="https://github.com/ash6898/aem-component-library"
            imagePath="/content/aakash-portfolio/assets/images/project1_img.png"/>

        <project2
            jcr:primaryType="nt:unstructured"
            sling:resourceType="component-library/components/project-card"
            title="AEM Platform, Chubb Insurance"
            description="Associate Software Developer (AEM Platform) at Accenture, January to October 2021. Client: Chubb Insurance, on AEM 6.x. Published and maintained 100+ pages, standardised reusable component templates that reduced authoring time by about 30%, administered DAM workflows, and completed cross-browser and WCAG 2.0 QA.&lt;br&gt;&lt;br&gt;Client code is proprietary and is not in this repository.&lt;br&gt;"
            imagePath="/content/aakash-portfolio/assets/images/project2_img.png"/>

        <project3
            jcr:primaryType="nt:unstructured"
            sling:resourceType="component-library/components/project-card"
            title="Android Development, Zoho"
            description="Android Developer at Zoho from November 2021 to December 2022.&lt;br&gt;&lt;br&gt;Product code from that role is proprietary and is not in this repository.&lt;br&gt;"
            imagePath="/content/aakash-portfolio/assets/images/project3_img.png"/>

        <contact-title
            jcr:primaryType="nt:unstructured"
            sling:resourceType="component-library/components/section-title"
            title="Contact Me"/>

        <contact-form
            jcr:primaryType="nt:unstructured"
            sling:resourceType="component-library/components/contact-form"
            formAction="https://formspree.io/f/mdaloaae"
            submitLabel="Send"
            successTitle="Thank you!"
            successText="Your message has been sent. I'll get back to you soon."/>

        <footer
            jcr:primaryType="nt:unstructured"
            sling:resourceType="component-library/components/footer"
            footerText="© 2026 Aakash Portfolio">
            <navItems jcr:primaryType="nt:unstructured">
                <item1
                    jcr:primaryType="nt:unstructured"
                    label="LinkedIn"
                    path="https://www.linkedin.com/in/aakashbaskaran/"
                    iconPath="/content/aakash-portfolio/assets/icons/linkedin.svg"/>
                <item2
                    jcr:primaryType="nt:unstructured"
                    label="Github"
                    path="https://github.com/ash6898/"
                    iconPath="/content/aakash-portfolio/assets/icons/github.svg"/>
                <item3
                    jcr:primaryType="nt:unstructured"
                    label="Email"
                    path="mailto:aakash.baskaran.1305@gmail.com"
                    iconPath="/content/aakash-portfolio/assets/icons/email.svg"/>
            </navItems>
        </footer>
    </jcr:content>
</jcr:root>
